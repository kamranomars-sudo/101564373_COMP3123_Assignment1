  "item": [
    {
      "name": "Health and Helmet headers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
